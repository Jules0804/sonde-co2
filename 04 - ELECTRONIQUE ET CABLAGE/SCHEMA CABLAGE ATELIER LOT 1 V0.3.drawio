        <mxCell id="title" value="Schéma atelier corrigé — câblage réel Wemos S2 Mini + SEN0536 + DFR0971" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="35" width="1200" height="42" as="geometry"/></mxCell>
        <mxCell id="sub" value="Wemos avec 4 colonnes de broches. DFR0971 : bornier VOUT1/GND/VOUT0, connecteur Gravity + / - / C / D. C=SCL, D=SDA." style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#526273" vertex="1" parent="1"><mxGeometry x="50" y="78" width="1300" height="28" as="geometry"/></mxCell>

        <mxCell id="wcard" value="U1 — Wemos S2 Mini V1.0.0&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;vue dessus, USB en bas, deux colonnes de trous par côté&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9daec2;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="40" y="125" width="585" height="840" as="geometry"/></mxCell>
        <mxCell id="wpcb" value="S2 Mini&lt;br&gt;WEMOS.CC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8e24aa;strokeColor=#4a1260;fontColor=#ffffff;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="230" y="235" width="270" height="560" as="geometry"/></mxCell>
        <mxCell id="w_3v3" value="3V3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#ff6f00;strokeWidth=3;fontSize=13;fontFamily=Consolas" vertex="1" parent="1"><mxGeometry x="215" y="590" width="60" height="30" as="geometry"/></mxCell>
        <mxCell id="w_gnd" value="GND" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#ff6f00;strokeWidth=3;fontSize=13;fontFamily=Consolas" vertex="1" parent="1"><mxGeometry x="412" y="540" width="60" height="30" as="geometry"/></mxCell>
        <mxCell id="w_sda" value="15 / SDA" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#ff6f00;strokeWidth=3;fontSize=13;fontFamily=Consolas" vertex="1" parent="1"><mxGeometry x="402" y="590" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="w_scl" value="21 / SCL" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#ff6f00;strokeWidth=3;fontSize=13;fontFamily=Consolas" vertex="1" parent="1"><mxGeometry x="402" y="440" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="wpins" value="Repères Wemos utilisés :&lt;br&gt;3V3 = colonne extérieure gauche, dernière ligne&lt;br&gt;GND = colonne intérieure droite, avant-dernière ligne&lt;br&gt;SDA = GPIO15, colonne intérieure droite, dernière ligne&lt;br&gt;SCL = GPIO21, colonne intérieure droite, ligne 21/18" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=14;fontFamily=Consolas" vertex="1" parent="1"><mxGeometry x="70" y="710" width="525" height="185" as="geometry"/></mxCell>

        <mxCell id="scard" value="U3 — Sonde CO₂ SEN0536 / SCD41&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;connecteur imprimé SDA / SCL / GND / VCC, adresse 0x62&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9daec2;fontSize=18;fontStyle=1" vertex="1" parent="1"><mxGeometry x="690" y="125" width="430" height="360" as="geometry"/></mxCell>
