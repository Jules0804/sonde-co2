        <mxCell id="warn" value="Contrôle avant mise sous tension : USB seul, 3V3 vers modules, pas VBUS, pas moteur. Scan attendu : DAC 0x5F + sonde 0x62." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;fontSize=16;fontStyle=1" vertex="1" parent="1"><mxGeometry x="50" y="1000" width="1700" height="62" as="geometry"/></mxCell>
